generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Business {
  id             Int              @id @default(autoincrement()) @map("business_id")
  name           String           @map("business_name") @db.VarChar(200)
  contactPerson  String?          @map("contact_person") @db.VarChar(200)
  address        String?          @db.VarChar(500)
  userBusinesses UserBusiness[]
  members        GymMember[]
  plans          MembershipPlan[]

  @@map("businesses")
}

model User {
  id             Int            @id @default(autoincrement()) @map("user_id")
  fullName       String         @map("full_name") @db.VarChar(200)
  email          String         @unique @db.VarChar(200)
  passwordHash   String         @map("password_hash") @db.VarChar(500)
  userBusinesses UserBusiness[]

  @@map("users")
}

model UserBusiness {
  userId     Int      @map("user_id")
  businessId Int      @map("business_id")
  role       String   @db.VarChar(50)
  user       User     @relation(fields: [userId], references: [id])
  business   Business @relation(fields: [businessId], references: [id])

  @@id([userId, businessId])
  @@map("user_businesses")
}

model GymMember {
  id                Int                      @id @default(autoincrement()) @map("member_id")
  memberNo          String                   @unique @map("member_no") @db.VarChar(20)
  firstName         String                   @map("first_name") @db.VarChar(100)
  lastName          String                   @map("last_name") @db.VarChar(100)
  gender            String?                  @db.VarChar(10)
  dateOfBirth       DateTime?                @map("date_of_birth") @db.Date
  email             String?                  @db.VarChar(200)
  phone             String?                  @db.VarChar(20)
  address           String?                  @db.VarChar(500)
  membershipType    Int                      @default(1) @map("membership_type")
  membershipStatus  Int                      @default(1) @map("membership_status")
  joinDate          DateTime                 @default(now()) @map("join_date") @db.Date
  businessId        Int?                     @map("business_id")
  business          Business?                @relation(fields: [businessId], references: [id])
  memberships       MemberMembership[]
  attendance        Attendance[]
  bodyProgress      BodyProgress[]
  emergencyContacts MemberEmergencyContact[]

  @@map("gym_members")
}

model MembershipPlan {
  id            Int                @id @default(autoincrement()) @map("plan_id")
  name          String             @map("plan_name") @db.VarChar(200)
  durationValue Int                @map("duration_value")
  durationUnit  Int                @map("duration_unit")
  price         Decimal            @db.Decimal(10, 2)
  description   String?            @db.VarChar(500)
  businessId    Int?               @map("business_id")
  business      Business?          @relation(fields: [businessId], references: [id])
  memberships   MemberMembership[]

  @@map("membership_plans")
}

model MemberMembership {
  id          Int                 @id @default(autoincrement()) @map("membership_id")
  memberId    Int                 @map("member_id")
  planId      Int                 @map("plan_id")
  startDate   DateTime            @map("start_date") @db.Date
  endDate     DateTime            @map("end_date") @db.Date
  totalAmount Decimal             @map("total_amount") @db.Decimal(10, 2)
  member      GymMember           @relation(fields: [memberId], references: [id])
  plan        MembershipPlan      @relation(fields: [planId], references: [id])
  payments    MembershipPayment[]

  @@map("member_memberships")
}

model MembershipPayment {
  id           Int              @id @default(autoincrement()) @map("payment_id")
  membershipId Int              @map("membership_id")
  amount       Decimal          @db.Decimal(10, 2)
  paymentDate  DateTime         @map("payment_date") @db.Date
  paymentMode  Int              @map("payment_mode")
  referenceNo  String?          @map("reference_no") @db.VarChar(100)
  membership   MemberMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@map("membership_payments")
}

model Attendance {
  id       Int       @id @default(autoincrement()) @map("attendance_id")
  memberId Int       @map("member_id")
  checkIn  DateTime  @map("check_in")
  checkOut DateTime? @map("check_out")
  member   GymMember @relation(fields: [memberId], references: [id])

  @@map("attendance")
}

model BodyProgress {
  id           Int       @id @default(autoincrement()) @map("progress_id")
  memberId     Int       @map("member_id")
  progressDate DateTime  @map("progress_date") @db.Date
  weight       Decimal?  @db.Decimal(5, 2)
  bmi          Decimal?  @db.Decimal(5, 2)
  fat          Decimal?  @db.Decimal(5, 2)
  muscle       Decimal?  @db.Decimal(5, 2)
  notes        String?   @db.VarChar(500)
  member       GymMember @relation(fields: [memberId], references: [id])

  @@map("body_progress")
}

model MemberEmergencyContact {
  id           Int       @id @default(autoincrement()) @map("contact_id")
  memberId     Int       @map("member_id")
  name         String    @db.VarChar(200)
  relationship String?   @db.VarChar(100)
  phone        String    @db.VarChar(20)
  member       GymMember @relation(fields: [memberId], references: [id])

  @@map("member_emergency_contacts")
}
